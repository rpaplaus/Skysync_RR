# =====================================================================
# Skysync - Spotify Developer Credentials (.env)
# =====================================================================
# Obtenha suas credenciais no Spotify Developer Dashboard:
# https://developer.spotify.com/dashboard
#
# 1. Crie uma aplicação no dashboard do Spotify.
# 2. Em "Edit Settings", adicione em Redirect URIs:
#    http://127.0.0.1:8000/api/v1/auth/callback
# 3. Copie o Client ID e Client Secret e cole abaixo.
# =====================================================================

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
