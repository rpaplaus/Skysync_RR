{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Skysync: Servidor FastAPI (Live Reload)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--reload",
        "--port",
        "3000"
      ],
      "jinja": true,
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Skysync: Executar main.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Skysync: Rodar Testes da API",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/test_api.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
